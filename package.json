{
  "name": "masrexach",
  "type": "module",
  "version": "1.3.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "rm -rf node_modules/.vite && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "bash scripts/verify.sh",
    "verify:full": "bash scripts/verify.sh --full",
    "clean": "rm -rf node_modules/.vite dist",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip",
    "depcruise": "depcruise src tests",
    "test": "vitest run",
    "test:fast": "bash scripts/test.sh fast",
    "test:changed": "bash scripts/test.sh changed",
    "test:og": "OG_VERIFY_BUILD=1 vitest run tests/og-output.test.ts",
    "test:worker": "node scripts/test-worker.mjs",
    "smoke": "node scripts/smoke.mjs",
    "sync:secrets": "bash scripts/sync-secrets.sh",
    "lighthouse": "lhci autorun",
    "osv": "osv-scanner scan source --lockfile=./pnpm-lock.yaml --config=osv-scanner.toml",
    "format:check": "biome format .",
    "astro:doctor": "astro-doctor",
    "check:all": "pnpm format && pnpm format:check && pnpm lint:fix && pnpm lint && pnpm astro:doctor && pnpm check && pnpm knip && pnpm depcruise && pnpm test",
    "prepare": "simple-git-hooks",
    "astro": "astro"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec biome check --staged --no-errors-on-unmatched --files-ignore-unknown=true && bash scripts/pre-commit-gitleaks.sh",
    "pre-push": "pnpm verify"
  },
  "dependencies": {
    "@astrojs/cloudflare": "~14.4.4",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "~7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.4",
    "@lhci/cli": "^0.16.0",
    "@santi020k/astro-doctor": "^1.7.0",
    "@tailwindcss/vite": "^4.3.4",
    "dependency-cruiser": "^18.7.2",
    "knip": "^6.44.1",
    "playwright": "1.65.0",
    "sharp": "0.35.5",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0",
    "yaml": "^2.9.1"
  }
}
