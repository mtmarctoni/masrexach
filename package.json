{
  "name": "masrexach",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "rm -rf node_modules/.vite && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "clean": "rm -rf node_modules/.vite dist",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip",
    "depcruise": "depcruise src tests",
    "test": "vitest run",
    "test:worker": "node scripts/test-worker.mjs",
    "smoke": "node scripts/smoke.mjs",
    "deploy": "bash scripts/deploy.sh",
    "sync:secrets": "bash scripts/sync-secrets.sh",
    "lighthouse": "lhci autorun",
    "osv": "osv-scanner scan source --lockfile=./pnpm-lock.yaml --config=osv-scanner.toml",
    "format:check": "biome format .",
    "astro:doctor": "astro-doctor",
    "check:all": "pnpm format && pnpm format:check && pnpm lint:fix && pnpm lint && pnpm astro:doctor && pnpm check && pnpm knip && pnpm depcruise && pnpm test",
    "prepare": "simple-git-hooks",
    "astro": "astro"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec biome check --staged --no-errors-on-unmatched --files-ignore-unknown=true && bash scripts/pre-commit-gitleaks.sh",
    "pre-push": "pnpm check:all"
  },
  "dependencies": {
    "@astrojs/cloudflare": "~14.4.3",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "~7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.4",
    "@lhci/cli": "^0.15.1",
    "@santi020k/astro-doctor": "^1.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.44.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
