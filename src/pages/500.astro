---
import type { Locale } from "../i18n";
import { getDict, localizedPath } from "../i18n";
import Base from "../layouts/Base.astro";

const locale: Locale = "es";
const dict = getDict(locale);
---

<Base
  locale={locale}
  title={`500 — ${dict.home.title}`}
  description={dict.home.description}
  path="/"
  indexable={false}
>
  <section class="py-24 text-center">
    <p class="font-display text-6xl font-semibold text-accent">500</p>
    <h1 class="mt-4 font-display text-2xl font-semibold text-ink">
      Error del servidor
    </h1>
    <p class="mx-auto mt-3 max-w-md text-sm text-ink-soft">
      Algo ha salido mal. Inténtalo de nuevo en unos instantes.
    </p>
    <a
      href={localizedPath(locale, "/catalogo")}
      class="mt-8 inline-flex items-center justify-center rounded-sm bg-accent px-6 py-2.5 text-sm font-medium text-surface motion-safe:transition-colors hover:bg-accent-strong"
    >
      {dict.nav.catalog}
    </a>
  </section>
</Base>