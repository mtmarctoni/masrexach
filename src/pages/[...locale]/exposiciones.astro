---
import type { Locale } from "../../i18n";
import { getDict, localeRoutes } from "../../i18n";
import Base from "../../layouts/Base.astro";

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props;
const dict = getDict(locale);

const columns = [
  { heading: dict.exhibitions.collectiveHeading, items: dict.exhibitions.collective },
  { heading: dict.exhibitions.individualHeading, items: dict.exhibitions.individual },
];
---

<Base
  locale={locale}
  title={dict.exhibitions.title}
  description={dict.exhibitions.description}
  path="/exposiciones"
>
  <section class="py-10">
    <h1
      class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
    >
      {dict.exhibitions.heading}
    </h1>

    <div class="mt-10 grid gap-12 md:grid-cols-2 md:gap-16">
      {
        columns.map(({ heading, items }) => (
          <section>
            <h2 class="font-display text-sm font-semibold uppercase tracking-widest text-accent-strong">
              {heading}
            </h2>
            <ul class="mt-6">
              {
                items.map((entry) => (
                  <li class="mt-3 first:mt-0 text-sm leading-relaxed text-ink-soft">"text-sm leading-relaxed text-ink-soft">{entry}</li>
                ))
              }
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Base>
