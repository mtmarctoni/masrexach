---
import { getDict, localeRoutes } from "../../i18n";
import Base from "../../layouts/Base.astro";

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props;
const dict = getDict(locale);

interface ExhibitionEntry {
  year: string | null;
  venue: string;
}

/** Entries look like "1983 – Galería Parnaso, Palma." — split the year out
    so it can be set in tabular figures in its own column. */
function parseEntry(entry: string): ExhibitionEntry {
  const match = entry.match(/^(\d{4})\s*[–-]\s*(.+)$/s);
  if (!match) return { year: null, venue: entry };
  return { year: match[1], venue: match[2] };
}

const columns = [
  {
    heading: dict.exhibitions.collectiveHeading,
    items: dict.exhibitions.collective.map(parseEntry),
  },
  {
    heading: dict.exhibitions.individualHeading,
    items: dict.exhibitions.individual.map(parseEntry),
  },
];
---

<Base
  locale={locale}
  title={dict.exhibitions.title}
  description={dict.exhibitions.description}
  path="/exposiciones"
>
  <section class="py-14 sm:py-20">
    <h1
      class="font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl"
    >
      {dict.exhibitions.heading}
    </h1>

    <div class="mt-12 grid gap-14 md:grid-cols-2 md:gap-x-16 lg:gap-x-20">
      {
        columns.map(({ heading, items }) => (
          <section>
            <h2 class="kicker border-b border-ink pb-3 text-ink">
              {heading}
            </h2>
            <ol>
              {items.map(({ year, venue }) => (
                <li class="flex gap-4 border-b border-border py-3.5 sm:gap-6">
                  {year !== null && (
                    <span class="tnum w-12 shrink-0 pt-0.5 font-display text-sm font-medium text-accent-strong">
                      {year}
                    </span>
                  )}
                  <span class="text-[15px] leading-relaxed text-ink-soft">
                    {venue}
                  </span>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </section>
</Base>
