---
import type { Locale } from "../../i18n";
import { getDict, localeRoutes } from "../../i18n";
import Base from "../../layouts/Base.astro";

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props;
const dict = getDict(locale);
---

<Base
  locale={locale}
  title={dict.legal.title}
  description={dict.legal.description}
  path="/legal"
>
  <section class="py-10">
    <h1
      class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
    >
      {dict.legal.heading}
    </h1>

    <div class="mt-10 max-w-3xl">
      {
        dict.legal.sections.map(({ heading, paragraphs }) => (
          <section class="mt-10 first:mt-0">
            <h2 class="font-display text-lg font-semibold text-ink">{heading}</h2>
            <div class="mt-3 text-[15px] leading-relaxed text-ink-soft">
              {
                paragraphs.map((paragraph) => (
                  <p class="mt-3 first:mt-0">{paragraph}</p>
                ))
              }
            </div>
          </section>
        ))
      }
    </div>
  </section>
</Base>
