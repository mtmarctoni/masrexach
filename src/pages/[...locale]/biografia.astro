---
import type { Locale } from "../../i18n";
import { getDict, localeRoutes } from "../../i18n";
import Base from "../../layouts/Base.astro";

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props;
const dict = getDict(locale);
---

<Base
  locale={locale}
  title={dict.biography.title}
  description={dict.biography.description}
  path="/biografia"
>
  <section class="py-10">
    <h1
      class="font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
    >
      {dict.biography.heading}
    </h1>
    <div class="mt-10 max-w-3xl text-[15px] leading-relaxed text-ink-soft">
      {
        dict.biography.paragraphs.map((paragraph) => (
          <p class="mt-5 first:mt-0">{paragraph}</p>
        ))
      }
    </div>
  </section>
</Base>
