---
import { getImage } from "astro:assets";
import portraitSrc from "../../assets/images/antoni-mas-rexach.jpg";
import { getDict, localeRoutes } from "../../i18n";
import Base from "../../layouts/Base.astro";

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props;
const dict = getDict(locale);

const portrait = await getImage({
  src: portraitSrc,
  width: 460,
  quality: 80,
  format: "webp",
});
---

<Base
  locale={locale}
  title={dict.biography.title}
  description={dict.biography.description}
  path="/biografia"
>
  <section class="py-14 sm:py-20">
    <h1
      class="font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl"
    >
      {dict.biography.heading}
    </h1>

    <div
      class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,21rem)_minmax(0,1fr)] lg:gap-16"
    >
      <figure class="self-start lg:sticky lg:top-24">
        <img
          src={portrait.src}
          width={portrait.attributes.width}
          height={portrait.attributes.height}
          alt={dict.biography.portraitAlt}
          loading="eager"
          decoding="async"
          class="w-full rounded-sm border border-border bg-surface-alt"
        />
        <figcaption
          class="mt-3 flex items-baseline gap-3 text-xs text-ink-faint"
        >
          <span aria-hidden="true" class="inline-block h-px w-6 bg-accent"
          ></span>
          {dict.biography.portraitCaption}
        </figcaption>
      </figure>

      <div class="max-w-2xl text-[15px] leading-relaxed text-ink-soft">
        {
          dict.biography.paragraphs.map((paragraph, index) => (
            <p class={index === 0 ? "dropcap" : "mt-5"}>{paragraph}</p>
          ))
        }
      </div>
    </div>
  </section>
</Base>
