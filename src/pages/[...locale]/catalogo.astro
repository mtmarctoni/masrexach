---
import { Image } from "astro:assets";
import type { Artwork } from "../../data/artworks";
import { availableArtworks, soldArtworks } from "../../data/artworks";
import { getDict, localeRoutes, localizedPath, statusLabels } from "../../i18n";
import Base from "../../layouts/Base.astro";
import { thumbnailOptions } from "../../lib/thumbnail";

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props;
const dict = getDict(locale);
const labels = statusLabels(dict);

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/images/artwork/*.jpg",
  { eager: true },
);

function prepare(art: Artwork) {
  const module = imageModules[`../../assets/images/artwork/${art.image}`];
  const image = module?.default;
  return { art, image };
}

// The first two artworks can enter the initial mobile viewport and become LCP.
// Keep them eager/high-priority; the remaining non-featured works stay lazy.
const available = availableArtworks().map(prepare);
const sold = soldArtworks().map(prepare);
---

<Base
  locale={locale}
  title={dict.catalog.title}
  description={dict.catalog.description}
  path="/catalogo"
>
  <section class="border-b border-border pb-10 pt-14 sm:pt-20">
    <p class="kicker text-accent-strong">Antoni Mas Rexach</p>
    <h1
      class="mt-4 font-display text-5xl font-semibold tracking-tight text-ink sm:text-6xl"
    >
      {dict.catalog.heading}
    </h1>
    <p class="mt-6 max-w-xl text-[15px] leading-relaxed text-ink-soft">
      {dict.catalog.intro}
    </p>
  </section>

  <section class="py-12">
    <h2 class="font-display text-2xl font-semibold tracking-tight text-ink">
      {dict.catalog.availableHeading}
    </h2>
    <ul class="mt-8 columns-2 gap-6 lg:columns-3 lg:gap-7">
      {
        available.map(({ art, image }, index) => (
          <li class="mb-7 break-inside-avoid">
            <a href={localizedPath(locale, `/catalogo/${art.slug}`)} class="group block">
              {image ? (
                <Image
                  src={image}
                  {...thumbnailOptions(image, "catalogue")}
                  quality={72}
                  format="webp"
                  alt={`${art.title} — ${art.caption[locale]}`}
                  class="h-auto w-full shadow-[0_10px_24px_-14px_rgb(33_29_23/0.45)] motion-safe:transition-shadow motion-safe:duration-300 motion-safe:group-hover:shadow-[0_18px_36px_-16px_rgb(33_29_23/0.55)]"
                  loading={index < 2 || art.featured ? "eager" : "lazy"}
                  fetchpriority={index < 2 ? "high" : undefined}
                  decoding="async"
                />
              ) : (
                <span class="block aspect-square" aria-hidden="true" />
              )}
              <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                <p class="font-display text-[15.5px] font-semibold text-ink">{art.title}</p>
                <p class="text-xs text-ink-faint">{art.caption[locale]}</p>
              </div>
              <p class="mt-1 text-xs font-bold uppercase tracking-[0.14em] text-accent-strong">
                {labels[art.status]}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    sold.length > 0 && (
      <section class="border-t border-border py-12">
        <h2 class="font-display text-2xl font-semibold tracking-tight text-ink">
          {dict.catalog.soldHeading}
        </h2>
        <ul class="mt-8 columns-2 gap-6 lg:columns-3 lg:gap-7">
          {sold.map(({ art, image }) => (
            <li class="mb-7 break-inside-avoid">
              <a
                href={localizedPath(locale, `/catalogo/${art.slug}`)}
                class="block opacity-75"
              >
                {image ? (
                  <Image
                    src={image}
                    {...thumbnailOptions(image, "catalogue")}
                    quality={72}
                    format="webp"
                    alt={`${art.title} — ${art.caption[locale]}`}
                    class="h-auto w-full shadow-[0_10px_24px_-14px_rgb(33_29_23/0.45)]"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="block aspect-square" aria-hidden="true" />
                )}
                <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                  <p class="font-display text-[15.5px] font-semibold text-ink">{art.title}</p>
                  <p class="text-xs text-ink-faint">{art.caption[locale]}</p>
                </div>
                <p class="mt-1 text-xs font-bold uppercase tracking-[0.14em] text-ink-faint">
                  {labels[art.status]}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
