---
import Gallery from "../../components/Gallery.astro";
import { getDict, localeRoutes } from "../../i18n";
import Base from "../../layouts/Base.astro";

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props;
const dict = getDict(locale);
---

<Base
  locale={locale}
  title={dict.home.title}
  description={dict.home.description}
  path="/"
>
  <section class="border-b border-border pb-10 pt-14 sm:pt-20">
    <p class="kicker text-accent-strong">Antoni Mas Rexach</p>
    <h1
      class="mt-4 max-w-3xl font-display text-5xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-6xl"
    >
      {dict.home.heading}
    </h1>
    <p class="mt-6 max-w-xl text-[15px] leading-relaxed text-ink-soft">
      {dict.home.description}
    </p>
  </section>

  <Gallery locale={locale} />
</Base>
