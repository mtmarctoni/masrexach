---
import type { Locale } from "../i18n";
import { getDict, localizedPath } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);

const nav = [
  { href: "/catalogo", label: dict.nav.catalog },
  { href: "/biografia", label: dict.nav.biography },
  { href: "/exposiciones", label: dict.nav.exhibitions },
  { href: "/contacto", label: dict.nav.contact },
];
---

<footer class="mt-24 bg-ink text-paper-dark">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <p class="font-display text-2xl font-semibold tracking-tight">
      Antoni Mas Rexach
    </p>

    <div class="mt-12 flex flex-col gap-6 border-t border-ink-line pt-8 md:flex-row md:items-center md:justify-between">
      <nav aria-label={dict.a11y.footerNav}>
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {
            nav.map(({ href, label }) => (
              <li>
                <a
                  href={localizedPath(locale, href)}
                  class="text-sm text-paper-80 motion-safe:transition-colors hover:text-paper-dark"
                >
                  {label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={localizedPath(locale, "/legal")}
              class="text-sm text-paper-80 motion-safe:transition-colors hover:text-paper-dark"
            >
              {dict.legal.heading}
            </a>
          </li>
        </ul>
      </nav>

      <div class="text-sm text-paper-70">
        <p>{dict.constants.copyright}</p>
        <p>{dict.constants.copyright2}</p>
      </div>
    </div>
  </div>
</footer>
