<div class="artwork-frame">
  <slot />
  <span class="artwork-frame__rail artwork-frame__rail--top" aria-hidden="true"></span>
  <span class="artwork-frame__rail artwork-frame__rail--bottom" aria-hidden="true"></span>
  <span class="artwork-frame__rail artwork-frame__rail--left" aria-hidden="true"></span>
  <span class="artwork-frame__rail artwork-frame__rail--right" aria-hidden="true"></span>
</div>

<style>
  .artwork-frame {
    position: relative;
    padding: 26px;
    /* Near-black floating gap; a faint warm tint keeps it from reading as a hole. */
    background: #0d0b09;
    box-shadow: 3px 14px 24px -12px #30251b80, 0 2px 4px #30251b22;
  }

  .artwork-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: 1px 2px 4px #0009;
  }

  .artwork-frame__rail {
    position: absolute;
    pointer-events: none;
    background-color: #c8a47d;
    /* Translucent lighting preserves grain across the bevel and inner lip. */
    background-image:
      linear-gradient(180deg, #fff3, #fff0 14%, #fff0 50%, #57371d33 77%, #fff2 82%, #55351d55),
      url("/images/frame/oak-horizontal.svg");
    background-size: 100% 100%, 560px 100%;
  }

  .artwork-frame__rail--top,
  .artwork-frame__rail--bottom {
    left: 0;
    width: 100%;
    height: 21px;
    clip-path: polygon(0 0, 100% 0, calc(100% - 21px) 100%, 21px 100%);
  }

  .artwork-frame__rail--top {
    top: 0;
  }

  .artwork-frame__rail--bottom {
    bottom: 0;
    transform: rotate(180deg);
    filter: brightness(0.94);
  }

  .artwork-frame__rail--left,
  .artwork-frame__rail--right {
    top: 0;
    width: 21px;
    height: 100%;
    background-image:
      linear-gradient(90deg, #fff3, #fff0 14%, #fff0 50%, #57371d33 77%, #fff2 82%, #55351d55),
      url("/images/frame/oak-vertical.svg");
    background-size: 100% 100%, 100% 560px;
    clip-path: polygon(0 0, 100% 21px, 100% calc(100% - 21px), 0 100%);
  }

  .artwork-frame__rail--left {
    left: 0;
  }

  .artwork-frame__rail--right {
    right: 0;
    transform: rotate(180deg);
    filter: brightness(0.91);
  }
</style>
