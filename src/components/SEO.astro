---
import { Font } from "astro:assets";
import type { Locale } from "../i18n";
import { alternatePaths, localizedUrl, siteUrl } from "../i18n";
import { robotsDirective } from "../lib/robots";

interface Props {
  title: string;
  description: string;
  path: string;
  locale: Locale;
  ogImage?: string;
  indexable?: boolean;
}

const { title, description, path, locale, ogImage = "/og.jpg", indexable = true } = Astro.props;

// siteUrl is empty for preview builds (host unknown at build time), so
// canonical/hreflang/OG absolute-URL tags are skipped there — the pages are
// noindex anyway.
const canonical = siteUrl ? localizedUrl(locale, path) : undefined;
const alternates = siteUrl ? alternatePaths(locale, path) : undefined;
const image = siteUrl ? `${siteUrl}${ogImage}` : undefined;
---

<!doctype html>
<html lang={locale} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsDirective(indexable)} />
    <meta name="theme-color" content="#faf7f1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      alternates &&
        Object.entries(alternates).map(([key, href]) => (
          <link
            rel="alternate"
            hreflang={key}
            href={`${siteUrl}${href}`}
          />
        ))
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Antoni Mas Rexach" />
    <meta property="og:locale" content={locale} />
    {image && <meta property="og:image" content={image} />}
    {image && <meta property="og:image:alt" content="Pintura de Antoni Mas Rexach" />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    <Font cssVariable="--font-heading" preload />
    <Font cssVariable="--font-text" />
  </head>
</html>
