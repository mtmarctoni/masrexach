---
import type { Locale } from "../i18n";
import { getDict, localizedPath } from "../i18n";

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const dict = getDict(locale);

const locales: Array<{ code: Locale; label: string }> = [
  { code: "es", label: "ES" },
  { code: "ca", label: "CA" },
  { code: "en", label: "EN" },
];
---

<nav aria-label={dict.a11y.langSwitcher} class="flex items-center gap-1 text-xs tracking-wide">
  {
    locales.map(({ code, label }) =>
      code === locale ? (
        <span
          class="inline-flex rounded-sm px-2 py-1 font-semibold text-accent-strong"
          aria-current="true"
        >
          {label}
        </span>
      ) : (
        <a
          href={localizedPath(code, currentPath)}
          lang={code}
          class="inline-flex rounded-sm px-2 py-1 text-ink-soft motion-safe:transition-colors hover:text-accent-strong"
        >
          {label}
        </a>
      ),
    )
  }
</nav>
