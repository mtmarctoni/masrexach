---
import type { Locale } from "../i18n";
import { getDict, localizedPath } from "../i18n";
import LangSwitcher from "./LangSwitcher.astro";

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const dict = getDict(locale);

const links = [
  { href: "/", label: dict.nav.painting },
  { href: "/biografia", label: dict.nav.biography },
  { href: "/exposiciones", label: dict.nav.exhibitions },
  { href: "/contacto", label: dict.nav.contact },
];
---

<header class="sticky top-0 z-40 border-b border-border bg-surface/90 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-6">
    <a
      href={localizedPath(locale, "/")}
      class="font-display text-xl font-semibold tracking-tight text-ink motion-safe:transition-colors hover:text-accent-strong"
    >
      Antoni Mas Rexach
    </a>

    <nav aria-label={dict.nav.painting} class="hidden items-center gap-8 md:flex">
      {
        links.map(({ href, label }) => {
          const localized = localizedPath(locale, href);
          const active = currentPath === href;
          return (
            <a
              href={localized}
              aria-current={active ? "page" : undefined}
              class={active ? "text-sm font-medium text-ink underline decoration-accent decoration-2 underline-offset-8" : "text-sm text-ink-soft motion-safe:transition-colors hover:text-ink"}
            >
              {label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-3">
      <LangSwitcher locale={locale} currentPath={currentPath} />

      <button
        type="button"
        data-menu-toggle
        aria-controls="site-nav"
        aria-expanded="false"
        class="inline-flex h-9 w-9 items-center justify-center rounded-sm text-ink-soft motion-safe:transition-colors hover:text-ink md:hidden"
        aria-label={dict.a11y.openMenu}
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="site-nav"
    data-menu-panel
    aria-label={dict.nav.painting}
    class="hidden border-t border-border bg-surface px-6 pb-4 pt-2 md:hidden"
  >
    <ul class="flex flex-col gap-1">
      {
        links.map(({ href, label }) => {
          const localized = localizedPath(locale, href);
          const active = currentPath === href;
          return (
            <li>
              <a
                href={localized}
                aria-current={active ? "page" : undefined}
                class={active ? "block py-2 font-medium text-accent-strong" : "block py-2 text-ink-soft motion-safe:transition-colors hover:text-ink"}
              >
                {label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  import { initHeader } from "../scripts/header";
  initHeader();
</script>
