{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "masrexach",
  "compatibility_date": "2026-08-04",
  "routes": [{ "pattern": "masrexach.marctonimas.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Edge-enforced cap on contact-form submissions (5 per IP per minute,
  // read in src/actions/index.ts). The action relays mail to a caller-supplied
  // address, so it needs a limit that holds across cold starts and isolates.
  // namespace_id must be unique per binding and is non-inheritable, hence one
  // entry per environment.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "env": {
    "staging": {
      "name": "masrexach-staging",
      "routes": [{ "pattern": "masrexach-staging.marctonimas.com", "custom_domain": true }],
      "workers_dev": true,
      "preview_urls": true,
      "ratelimits": [
        {
          "name": "CONTACT_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 5, "period": 60 }
        }
      ]
    }
  }
}
