# masrexach.com — environment variables reference.
# Copy to .env (gitignored) for local builds. Real secrets never live here in CI:
# they are GitHub secrets synced to the Worker by scripts/sync-secrets.sh.

# --- Build -------------------------------------------------------------------
# Commit SHA baked into /api/health output (astro.config.mjs -> vite.define).
# GitHub Actions sets GITHUB_SHA automatically; local builds fall back to "unknown".
#GITHUB_SHA=

# Build-time environment selector: "Preview" | "Staging" | "Production".
# Injected by CI from GitHub environment variables (Settings > Environments)
# on each deploy workflow's build step. Drives indexing: robots.txt, robots
# <meta> and the X-Robots-Tag header are only index-allowed when this is
# exactly "Production"; anything else (unset, typo) is noindex. Local dev
# builds: leave unset to stay noindex.
#PUBLIC_BUILD_TYPE=

# Canonical origin for SEO output. Injected by CI from GitHub environment
# variables: the staging and production environments set it to their stable
# custom domains; preview leaves it unset so those builds emit no
# canonical/OG/hreflang URLs (their workers.dev host is only known after
# upload). Also feeds the production sitemap (astro.config site) and the
# robots.txt Sitemap line. Leave unset locally to keep the noindex and
# no-canonical defaults.
#PUBLIC_BASE_URL=

# --- App runtime (consumed via astro:env/server) -----------------------------
# Used by src/actions/index.ts (sendContact). Optional in the env schema: the
# contact form returns an error until the key and recipient are set. For
# `astro dev` local runs use .dev.vars instead (see .dev.vars.example) —
# wrangler/miniflare loads it.
#
# RESEND_API_KEY is a SECRET (GitHub secret → Worker secret via
# scripts/sync-secrets.sh on every deploy). The contact form's real credential.
#
# CONTACT_TO_EMAIL and CONTACT_FROM_EMAIL are NON-SECRET runtime config (public
# addresses), set as GitHub Variables and injected as Worker var bindings by
# scripts/deploy.sh (--var) on every deploy, per environment. They are never
# Worker secrets.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_PLACEHOLDER
CONTACT_TO_EMAIL=artista@PLACEHOLDER.example
# FROM address for contact emails. Must be from a verified Resend domain.
# The owner notification uses reply_to for the submitter's address.
CONTACT_FROM_EMAIL=Antoni Mas Rexach <masrexach@marctonimas.com>

# --- Deploy (scripts/deploy.sh, scripts/sync-secrets.sh) ---------------------
# Wrangler credentials. Export locally or set as GitHub secrets in CI.
# The token needs (dash.cloudflare.com > My Profile > API Tokens > Create Token):
#   Account: Workers Scripts:Edit, Workers KV Storage:Edit, Account Settings:Read
#   Zone (marctonimas.com — add masrexach.com later when its zone joins the
#   account): Zone:Read, DNS:Edit, Workers Routes:Edit, Rulesets:Edit
# Rulesets:Edit is what scripts/sync-waf-rules.sh needs; the rest predate it.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional override for the wrangler invocation (default: "pnpm exec wrangler").
#WRANGLER_BIN=pnpm exec wrangler

# --- Rate limiting (scripts/sync-waf-rules.sh) -------------------------------
# The zone the site's hostnames belong to (dash.cloudflare.com > the domain >
# Overview > Zone ID). Set as a GitHub secret. Without it the sync skips with a
# warning and the contact form deploys with no submission cap — the form mails
# a confirmation to whatever address is submitted, so an uncapped form can be
# driven in a loop to send mail to arbitrary people on your Resend quota and
# sending reputation.
CLOUDFLARE_ZONE_ID=
#
# Rule tuning. Defaults: 5 POST requests per 60s per IP, blocked for 600s, on
# masrexach.marctonimas.com and masrexach-staging.marctonimas.com. Override
# only if the defaults prove wrong in practice — Cloudflare accepts a fixed set
# of periods (10/60/120/300/600/3600) and your plan may restrict the rule count
# and the available actions.
#WAF_PROTECTED_HOSTS=masrexach.marctonimas.com masrexach-staging.marctonimas.com
#WAF_RATELIMIT_REQUESTS=5
#WAF_RATELIMIT_PERIOD=60
#WAF_RATELIMIT_TIMEOUT=600
#WAF_RATELIMIT_ACTION=block

# --- CI-only contexts (never put in .env) ------------------------------------
# VARS_CONTEXT and SECRETS_CONTEXT are injected by GitHub Actions
# (${{ toJSON(vars) }} / ${{ toJSON(secrets) }}) into the deploy scripts;
# GITHUB_TOKEN is auto-provided by Actions. Listed here only for inventory.

# --- Cloudflare Pages (informational) ----------------------------------------
# This repo deploys as a Worker (adapter-generated dist/server/wrangler.json),
# not Pages. If it is ever moved to Cloudflare Pages: set RESEND_API_KEY as a
# Pages secret (dashboard or `wrangler pages secret put`) and CONTACT_* as
# Pages environment variables, give the API token "Cloudflare Pages: Edit"
# permission, and pin the build Node version (CI uses .nvmrc via
# node-version-file).
#NODE_VERSION=22

